---
import career from "../../content/career.json";
---

<div>
  <!-- Intro -->
  <p class="text-sm leading-relaxed text-slate-300">
    社会課題の解決に関心があります。<br />
    なかでも医療・福祉の領域は、<br />
    10年近く現場で働いてきました。
  </p>
  <p class="mt-3 text-sm leading-relaxed text-slate-300">
    いまはその経験を土台に、<br />
    プロジェクトやものづくりを通して<br />
    課題の解決に取り組んでいます。
  </p>

  <!-- Timeline -->
  <ol class="mt-6 space-y-4 border-l border-navy-700 pl-5">
    {
      career.map((entry) => (
        <li class="relative">
          <span class="absolute left-[-23px] top-1.5 h-2 w-2 rounded-full bg-accent-500" />
          <p class="text-xs font-medium text-accent-400">{entry.period}</p>
          <p class="mt-0.5 text-sm font-semibold text-slate-200">{entry.title}</p>

          {entry.areas.length > 0 && (
            <p class="mt-1 text-xs leading-relaxed text-slate-400">
              {entry.areas.join("／")}
            </p>
          )}

          {entry.projects && (
            <div class="mt-2 flex flex-wrap gap-2">
              {entry.projects.map((project) => (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded border border-navy-700/50 px-2 py-1 text-xs text-slate-400 transition-colors hover:border-accent-500/50 hover:text-accent-400"
                >
                  <span class="font-semibold">{project.name}</span>
                  <span class="ml-1 text-slate-500">{project.description}</span>
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</div>
