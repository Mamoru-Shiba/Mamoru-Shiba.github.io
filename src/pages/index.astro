---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoLanding from "../components/sections/LogoLanding.astro";
import Career from "../components/sections/Career.astro";
---

<BaseLayout
  title="Mamoru Shiba"
  description="現場を知る。コードで解決する。介護福祉の現場で10年、その後システムエンジニアへ。Mamoru Shibaの個人紹介ページ。"
>
  <LogoLanding />
  <section
    id="profile"
    class="snap-section flex items-center justify-center bg-navy-950 px-6 py-10 text-slate-200"
  >
    <div class="grid w-full max-w-4xl gap-8 sm:grid-cols-2 sm:gap-12">
      <!-- Identity -->
      <div class="text-center sm:text-left">
        <img
          src="/images/profile.jpg"
          alt="Mamoru Shiba"
          class="mx-auto h-20 w-20 rounded-full object-cover ring-4 ring-navy-600 sm:mx-0"
        />
        <h1 class="mt-4 text-2xl font-bold text-white sm:text-3xl">Mamoru Shiba</h1>
        <p class="mt-1 text-sm text-accent-400">システムエンジニア / 介護福祉士</p>
        <p class="mt-3 text-base font-semibold text-slate-200">
          現場を知る。コードで解決する。
        </p>
      </div>

      <!-- Intro & Career -->
      <div class="sm:col-start-2 sm:row-span-2">
        <Career />
      </div>

      <!-- Contact -->
      <div class="text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-start">
          <a
            href="tel:080-6918-9823"
            class="inline-flex items-center gap-2 rounded-lg border border-navy-700/50 px-4 py-2 text-sm text-slate-300 transition-colors hover:border-accent-500/50 hover:text-accent-400"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
            </svg>
            Tel
          </a>
          <a
            href="mailto:m.shiba@studio-shiba.com"
            class="inline-flex items-center gap-2 rounded-lg border border-navy-700/50 px-4 py-2 text-sm text-slate-300 transition-colors hover:border-accent-500/50 hover:text-accent-400"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
            </svg>
            Email
          </a>
          <a
            href="https://github.com/Mamoru-Shiba"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-navy-700/50 px-4 py-2 text-sm text-slate-300 transition-colors hover:border-accent-500/50 hover:text-accent-400"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            GitHub
          </a>
        </div>
        <p class="mt-4 text-xs text-slate-500">
          インボイス登録番号：T9810378253047
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
