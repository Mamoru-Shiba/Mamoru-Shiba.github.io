---
import BaseLayout from "../layouts/BaseLayout.astro";

// 中身が決まったら、各項目の下に本文を書き足す
const products = [
  { name: "3Dプリントの靴", summary: "3Dプリンターで作る靴", items: ["サイズの測り方"] },
  { name: "kokooite", summary: "ドアの前に置く置き配マット", items: [] },
  { name: "koke-note", summary: "小さな紙をまとめるメモ帳カバー", items: [] },
];

const sections = [
  { heading: "値段", items: ["値段の目安", "送料", "お見積もりについて"] },
  {
    heading: "ご注文の流れ",
    items: ["お問い合わせ", "サイズの確認", "お見積もり", "お支払い", "製作", "発送"],
  },
  { heading: "お支払い", items: ["お支払い方法", "お支払いの時期"] },
  {
    heading: "返品について",
    items: ["お客様のご都合による返品", "不良品の場合", "色や質感の個体差"],
  },
  { heading: "届くまでの目安", items: ["製作にかかる期間", "発送方法"] },
  { heading: "お問い合わせ", items: [] },
];
---

<BaseLayout
  title="プロダクト | Studio Shiba"
  description="Studio Shiba のプロダクト。すべて受注生産で製作しています。"
>
  <main class="min-h-dvh bg-product-bg px-6 py-16 text-product-text">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-2xl font-bold text-product-text sm:text-3xl">プロダクト</h1>
      <p class="mt-3 text-sm text-product-text-sub">すべて受注生産で製作しています。</p>

      <div class="mt-10 space-y-4">
        {
          products.map(({ name, summary, items }) => (
            <section class="rounded-lg border border-product-line bg-product-bg-sub p-5">
              <h2 class="text-lg font-semibold text-product-text">{name}</h2>
              <p class="mt-1 text-sm text-product-text">{summary}</p>
              {items.length > 0 && (
                <ul class="mt-2 space-y-1 text-sm text-product-text">
                  {items.map((item) => (
                    <li>・{item}</li>
                  ))}
                </ul>
              )}
              <p class="mt-2 text-sm text-product-text-sub">準備中</p>
            </section>
          ))
        }
      </div>

      <div class="mt-12 space-y-8">
        {
          sections.map(({ heading, items }) => (
            <section>
              <h2 class="border-l-2 border-product-accent pl-3 text-lg font-semibold text-product-text">
                {heading}
              </h2>
              {items.length > 0 && (
                <ul class="mt-2 space-y-1 pl-3 text-sm text-product-text">
                  {items.map((item) => (
                    <li>・{item}</li>
                  ))}
                </ul>
              )}
              <p class="mt-2 pl-3 text-sm text-product-text-sub">準備中</p>
            </section>
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-4">
        <a
          href="/"
          class="inline-flex items-center rounded-lg border border-product-line px-4 py-2 text-sm text-product-text transition-colors hover:border-product-accent hover:text-product-accent"
        >
          トップへ戻る
        </a>
        <a href="/legal" class="text-xs text-product-accent underline hover:text-product-text">
          特定商取引法に基づく表記
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
